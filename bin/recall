#!/usr/bin/env bash
# Usage: recall <topic>
# Searches only canonical semantic/procedural/strategic notes. Prints up to 4 hits.
# This is a package-managed file: install.sh overwrites it on every run.
set -euo pipefail
ANVIL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
QUERY="${1:-}"
if [ -z "$QUERY" ]; then
  echo "usage: recall <topic>" >&2
  exit 1
fi
if ! command -v rg >/dev/null 2>&1; then
  echo "ripgrep (rg) is required. Install with: brew install ripgrep" >&2
  exit 1
fi

# Local usage log — machine-local only, deliberately kept outside $ANVIL_ROOT
# so it never syncs via Syncthing. Never let logging failures break a read.
log_usage() {
  {
    LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/anvil"
    LOG_FILE="$LOG_DIR/usage.tsv"
    mkdir -p "$LOG_DIR"
    printf '%s\tread\t%s\t%s\t%s\t%s\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$QUERY" "$1" "$2" "$3" >> "$LOG_FILE"
  } 2>/dev/null || true
}

CANON_FILES=$(grep -rl "status: canonical" \
  "$ANVIL_ROOT/semantic" "$ANVIL_ROOT/procedural" "$ANVIL_ROOT/strategic" 2>/dev/null || true)

if [ -z "$CANON_FILES" ]; then
  echo "No canonical notes yet."
  log_usage 0 0 0
  exit 0
fi

MATCHES=$(echo "$CANON_FILES" | xargs -I{} grep -li "$QUERY" {} 2>/dev/null | head -n 4 || true)

if [ -z "$MATCHES" ]; then
  echo "No canonical notes match: $QUERY"
  log_usage 0 0 0
  exit 0
fi

HIT_COUNT=0
TOTAL_WORDS=0
TOTAL_CHARS=0
for f in $MATCHES; do
  echo "----- $f -----"
  cat "$f"
  echo
  HIT_COUNT=$((HIT_COUNT + 1))
  w=$(wc -w < "$f" | tr -d ' ')
  c=$(wc -c < "$f" | tr -d ' ')
  TOTAL_WORDS=$((TOTAL_WORDS + w))
  TOTAL_CHARS=$((TOTAL_CHARS + c))
done

log_usage "$HIT_COUNT" "$TOTAL_WORDS" "$TOTAL_CHARS"
